# Copy to .env in the repository root (untracked) and set the image, workspace and
# compute account; scripts/lumi/lumi.sh reads it (or the file in $ATOM_JEPA_ENV).
export ATOM_JEPA_WORK=/scratch/your_project/atom-jepa
export ATOM_JEPA_IMAGE=/absolute/path/to/compatible-rocm-pytorch.sif
export ATOM_JEPA_ACCOUNT=your_project_account
